<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>九州新婚蜜月賞楓地圖 (11/15~11/19 星宇 JX846/847 熊本進出精確版)</name>

  <Folder>
    <name>Day 1 (11/15 週日)：熊本機場取車 ➔ 菊池溪谷 ➔ 阿蘇大觀峰 ➔ 黑川溫泉</name>
    <Placemark>
      <name>阿蘇熊本空港（12:15取車）</name>
      <description><![CDATA[Day 1 起點：11:00 降落阿蘇熊本機場（JX 846），辦理入境與租車取車。]]></description>
      <Point><coordinates>130.8550000,32.8372000,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>菊池溪谷</name>
      <description><![CDATA[九州名瀑與清澈溪流，兩旁被濃密紅葉覆蓋（車程約35分鐘，步道漫步1.5小時）。]]></description>
      <Point><coordinates>130.9464583,33.0031556,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>阿蘇大觀峰</name>
      <description><![CDATA[俯瞰巨大的阿蘇火山口與金黃芒草全景（車程約25分鐘）。]]></description>
      <Point><coordinates>131.0670948,32.9956615,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>黑川溫泉（住宿）</name>
      <description><![CDATA[隱身於山林溪谷間的古樸溫泉鄉，入住日式溫泉旅館，穿浴衣享私人露天風呂（車程約30分鐘）。]]></description>
      <Point><coordinates>131.1419381,33.0777131,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>Day 2 (11/16 週一)：山波公路 ➔ 九重夢大吊橋/九醉溪 ➔ 耶馬溪 ➔ 由布院溫泉</name>
    <Placemark>
      <name>山波快速道路 (やまなみハイウェイ)</name>
      <description><![CDATA[日本百名道之一，沿途穿越芒草金黃與秋葉點綴的九重連峰。]]></description>
      <Point><coordinates>131.2150000,33.1200000,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>九重「夢」大吊橋</name>
      <description><![CDATA[日本最高的人行吊橋，漫步橋上可360度遠眺溪谷全景（車程約30分鐘）。]]></description>
      <Point><coordinates>131.2270660,33.1741770,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>九醉溪（九酔渓）</name>
      <description><![CDATA[秋季時山谷被染成一片熾紅與金黃，兩旁夾道的楓葉形成絕美紅葉隧道。]]></description>
      <Point><coordinates>131.2244400,33.1752800,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>耶馬溪 / 一目八景</name>
      <description><![CDATA[日本三大奇勝之一，展望台可同時欣賞八座奇岩怪石與滿山紅葉（車程約45分鐘）。]]></description>
      <Point><coordinates>131.1651282,33.3712227,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>由布院溫泉（住宿）</name>
      <description><![CDATA[入住高級日式溫泉旅館，下午逛湯之坪街道吃甜點，享用懷石料理（車程約50分鐘）。]]></description>
      <Point><coordinates>131.3555210,33.2625440,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>Day 3 (11/17 週二)：金鱗湖 ➔ 佐賀九年庵 ➔ 環境藝術之森 ➔ 熊本市區</name>
    <Placemark>
      <name>金鱗湖</name>
      <description><![CDATA[清晨的金鱗湖湖面常有晨霧繚繞，紅黃相間的楓葉映照在湖面上。]]></description>
      <Point><coordinates>131.3690386,33.2667196,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>佐賀 九年庵（11/14-11/29限定開放）</name>
      <description><![CDATA[每年僅在11月中下旬限時開放的秘境庭園。苔蘚綠地與滿園紅葉形成鮮明對比（車程約1.2小時）。]]></description>
      <Point><coordinates>130.3637265,33.3572228,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>環境藝術之森（環境芸術の森）</name>
      <description><![CDATA[佐賀秋天最紅絕景！館內「風遊山莊」漆面漆桌完美反射出窗外滿山鮮紅楓葉（車程約35分鐘）。]]></description>
      <Point><coordinates>130.0767341,33.3504935,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>熊本市區（住宿）</name>
      <description><![CDATA[入住熊本市區飯店，晚上享用熊本黑豚燒肉或馬肉料理（車程約1.2小時）。]]></description>
      <Point><coordinates>130.7082737,32.8033909,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>Day 4 (11/18 週三)：熊本市 ➔ 高千穗峽划船 ➔ 熊本市區購物</name>
    <Placemark>
      <name>高千穗峽</name>
      <description><![CDATA[柱狀節理懸崖峭壁與真名井瀑布交織（已預約10:30划船賞楓，車程約1.2小時）。]]></description>
      <Point><coordinates>131.3009390,32.7017851,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>天安河原</name>
      <description><![CDATA[漫步前往高千穗神話疊石洞窟。]]></description>
      <Point><coordinates>131.3120000,32.7150000,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>熊本通町筋 / 下通商圈</name>
      <description><![CDATA[返回熊本市區購物採買伴手禮，享用勝烈亭豬排。]]></description>
      <Point><coordinates>130.7100000,32.8010000,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>Day 5 (11/19 週四)：熊本城 ➔ 阿蘇熊本空港（10:35還車）</name>
    <Placemark>
      <name>熊本城</name>
      <description><![CDATA[日本三大名城之一，欣賞天守閣與秋季巨型金黃銀杏樹（車程約10分鐘）。]]></description>
      <Point><coordinates>130.7058330,32.8061110,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>阿蘇熊本空港（10:35還車搭機）</name>
      <description><![CDATA[Day 5 終點：10:35 完成還車，搭乘 12:15 星宇 JX 847 返回台北。]]></description>
      <Point><coordinates>130.8550000,32.8372000,0</coordinates></Point>
    </Placemark>
  </Folder>

  <Folder>
    <name>延伸口袋名單</name>
    <Placemark>
      <name>由布岳展望所</name>
      <description><![CDATA[可開車前往由布岳山麓展望所，俯瞰由布院盆地的秋季金黃與楓紅全景。]]></description>
      <Point><coordinates>131.3902373,33.2822897,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>雷山千如寺大悲王院</name>
      <description><![CDATA[寺內有約400年樹齡的日本大楓樹（福岡縣天然紀念物）。]]></description>
      <Point><coordinates>130.2285830,33.4946110,0</coordinates></Point>
    </Placemark>
  </Folder>

</Document>
</kml>
